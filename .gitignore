*.iml
.gradle
.kotlin
/.idea/
.DS_Store
build/
captures
.externalNativeBuild
.cxx
local.properties
.env
.env.local
.env.*.local
# Moi file .env bi loai tru, ngoai .env.example (ban mau khong chua key that,
# duoc commit co y de nguoi khac biet ten bien can dat).
.env.*
!.env.example
*.pem
*.key
*.pfx
*-debug.log

# Thu muc lam viec cua agent (settings, scratch, log). Chua duong dan may cua
# nguoi dung va co the chua key → khong bao gio di theo repo.
.qoder/

# Key ky. `debug.keystore` o duoi van duoc commit CO Y (xem giai thich ben
# duoi); cac key KHAC — ke upload, ke release, .jks — tuyet doi khong.
*.keystore
*.jks
!debug.keystore

# Debug keystore DUOC commit co y.
# Day la keystore debug mac dinh cua Android, mat khau "android" va
# keyAlias "androiddebugkey" la thong tin cong khai, khong phai bi mat.
# CI can file nay vi app/build.gradle.kts ky ban debug bang debugConfig.
# TUYET DOI khong dung no de ky ban phat hanh that.

# APK/AAB tuyet doi khong nam trong repo. `build/` o tren da bao che file CI sinh
# ra, nhung dong nay chan tiep ca khi co ai vo tinh (hay tool) roi file APK thang
# vao thu muc goc — APK chi tai tu Release GitHub, khong bao gio commit.
*.apk
*.aab
