rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Pairings and subcollections
    match /pairings/{pairingId} {
      allow read, write, create, update, delete: if isAuthenticated();
      
      match /schedules/{scheduleId} {
        allow read, write: if isAuthenticated();
      }
      match /extra_time/{requestId} {
        allow read, write: if isAuthenticated();
      }
      match /privacy_requests/{requestId} {
        allow read, write: if isAuthenticated();
      }
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
      match /location_history/{historyId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Pairing requests
    match /pairing_requests/{requestId} {
      allow read, write, create, update, delete: if isAuthenticated();
    }

    // Realtime locations
    match /locations/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Root location history
    match /location_history/{docId} {
      allow read, write: if isAuthenticated();
    }

    // SOS Alerts
    match /sos_alerts/{alertId} {
      allow read, write: if isAuthenticated();
    }
  }
}
