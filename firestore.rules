rules_version = '2';
// TRANG THAI FILE NAY (doc ky truoc khi deploy):
//
// Da khat: noi quy (`pairings/{id}/schedules`), nhat ky noi quy
// (`pairings/{id}/rule_audit` — chi them, khong sua; xoa duoc khi quan tri don
// hoac khi tai khoan dang bi don), va cac thu collection con lai nam DUOI
// document ghep noi (agreements, extra_time, privacy_requests, messages,
// location_history) — chi me/con cua cap do doc/ghi duoc, cong them quan tri
// (66.0: quan tri muon don tai khoan thi phai liet ke duoc nhung thu do; Firestore
// khong tu xoa subcollection cua mot document).
//
// Ban 65.0 khat them 5 khe o ngon tung de nguyen ("bat ky tai khoan nao
// duoc" = GPS ca nha, phieu SOS va tin hieu cuoc goi nam trong tay bat ky
// ai co mot tai khoan mien phi):
//   /locations        : chi chu may + nguoi DA GHEP NOI that va DA DUOC BEN
//                       KIA xac nhan (attestedPair), xem them ben duoi
//   /location_history : chi vet di chuyen CUA CHINH minh. Cap da ghep noi
//                       dung `pairings/{id}/location_history` (da khat tu truoc)
//   /sos_alerts       : chu may ghi, chu may + nguoi ghep noi doc
//   /calls            : phia goi dat roomId = pairings/{id} nen id document
//                       chinh la id ghep noi
//   /pairings/{id}    : doc/da = hai nguoi trong cap (hoac quan tri),
//                       tao = phai LA cha cua cap do (moi tai khoan tao ghep
//                       noi deu dung o vai phu huynh trong pairDirectly)
//   /pairing_requests : VÔ SINH (ban 59.0 bo PIN), den hoan toan
//
// BAN 66.0 — bon thay doi ve CHINH SACH, khong phai ve lop ke:
//   1. LENH CAM co PHAM VI va co HAN. `bans/<uid>` them `scope` ('ALL' = cam
//      dung app nhu cu, 'AI' = chi cat duong ghi bo dem hoi AI) va `expiresAt`
//      (co = tu mo sau 7/30 ngay, khong co = vinh vien den khi quan tri bam
//      "Bỏ cấm"). Lenh cam cua ban cu (63.0, chi uid + reason) van hieu la
//      "cam app, vinh vien" — moi dieu kien deu dung `in` kiem truong truoc.
//   2. TU XOA TAI KHOAN. `allow delete` o /users tung la `if false` (ban 55.0)
//      vi lo con nham. Nay mo cho CHU tai khoan (khi khong bi cam) va QUAN TRI.
//      App dan bang nut "Xóa tài khoản": xoa users/<uid> TRUOC, roi moi don
//      locations, vet di chuyen, phieu SOS, nhat ky + thu collection cua ghep
//      noi. Rules phan biet dong do voi "xoa don duong di de an duong" bang
//      accountIsBeingDeleted(): vi tri chi xoa duoc khi ho so KHONG CON, nen
//      mot may con nguyen ho so khong the xoa het vet cua no.
//      Trần khong vuot duoc o day: client khong co Admin SDK nen KHONG the
//      xoa tai khoan trong Authentication (email + mat khau). App phai noi
//      thang dieu do, dung la dua them nut "xoa" o nhung cho khong xoa duoc.
//   3. CAM AI chi cat duong bo dem tren /users, khong cat noi dung cu goi —
//      cau hoi AI di thang tu may len nha cung cap bang khoa trong APK.
//   4. QUAN TRI DUOC DOC LIET KE Moi collection cua nguoi dung (/locations,
//      /location_history, /sos_alerts va sau subcollection duoi /pairings).
//      Day la thay doi CO Y, khong phai su li xi: "xóa tài khoản" phia quan tri
//      phai biet duoc document id thi moi xoa duoc cai do — Firestore khong co
//      lenh xoa theo truong, khong tu xoa subcollection, va app khong co Admin
//      SDK. Nguoi co quyen nay la hai uid trong ham isAdmin() duoi day (cung la
//      allowlist trong `:admin`), tuc quyen quan tri = quyen doc ca nuoc.
//
// Vi SAO "co document ghep noi" CHUA DU: document ghep noi do client tu ghi,
// nen ke xau tu tao `pair_<minh>_<nan nhan>` voi status 'PAIRED' la duoc pairOfTwo
// nhay tay. attestedPair bat them mot chan: CHINH MAY BEN KIA phai ghi
// `activePairingId` len ho so cua no (users/{uid} chi isOwner sua duoc, ban
// 55.0). Ke xa lai trong duoc ho, vi ho khong co cach nao ghi len may cua nan nhan.
//
// VAN CON MO CO Y, phai noi thang trong bai KHKT:
//   - Mot may CHUA ghep noi, khi mo app, se tu nhan bat ky document ghep noi
//     nao ghi ten no (findPairingFor + linkSelfToPairing) — tuc ke tan cong co
//     the danh choi cua may dang trong trang thai "chua ai ghep". Chan tan goc
//     can nut "chấp nhận" phia may con hoac ghép nối do server cap (task #46);
//     rules mot minh thi khong lam duoc vi rules khong biet ai la ai.
//   - /users/{userId} doc duoc boi bat ky tai khoan nao: day la con duong duy
//     nhat de may phu huynh tim duoc con khi GO GAY bang `studentCode`
//     (findStudentByCode). That het khe nay la that bai chuc nang ghep noi.
//   - So luong va noi dung cau hoi AI van do CHINH may client ghi len; rules
//     o day giu con so (<=100, khong gia trong cung ngay) chu khong the biet
//     may da goi that bao nhieu lan — chan cung can proxy (task #45).
//   - Quy tac khong chan duoc IP: Firestore khong co bien IP, va dien thoai
//     di dong doi IP lien tuc qua CGNAT.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Thanh vien cua mot ghep noi: phai la parentId hoac childId tren chinh
    // document do. Dung cho noi quy + nhat ky, la noi me/con phai dong y.
    function isPairMember(pairingId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/pairings/$(pairingId)).data.parentId == request.auth.uid ||
        get(/databases/$(database)/documents/pairings/$(pairingId)).data.childId == request.auth.uid
      );
    }

    // QUAN TRI VIEN. Danh sach uid duoc lam quan tri, ghi thang vao day —
    // khong the lay tu client vi client nao cung sua duoc code cua no.
    // App `:admin` (package thanh.dev.app) cung kiem tra lai bang allowlist
    // trung ten trong MainActivity.kt; hai ben phai khop nhau.
    //
    // Hai ham duoc dat TRUOC moi match block dung den no: Firestore ghi chu
    // khai ham theo thu tu, de ham phia duoi mot block dang dung no la mot
    // cach de rules tu choi deploy luc minh khong mong.
    function isAdmin() {
      return isAuthenticated() && request.auth.uid in
        ["YU2BwDqvahSh1hUWx9NRAdOwvG33", "cSzzRXZzaVR83q2gQTnskhIxkzw2"];
    }

    // LENH CAM — ban 66.0: cam co PHAM VI va co THOI HAN.
    //
    // Document `bans/<uid>` la lenh cam duoc ghi boi quan tri (create/update/
    // delete chi isAdmin). Bon truong:
    //   scope     'ALL' = cam dung app (nhu cu), 'AI' = chi cam hoi tro ly AI
    //   expiresAt timestamp mo = tu mo sau han; KHONG co truong = vinh vien
    //                   den khi quan tri bam "Bỏ cấm"
    //   reason / bannedBy / bannedAt de in ra tren app khi bi cam
    //
    // Legacy (ban 63.0 ghi len chi co uid + reason): khong scope, khong
    // expiresAt => van hieu la "cam dung app, vinh vien" dung nhu cu. Vi vay
    // moi dieu kien o day deu phai dung `in` kiem truong truoc khi doc — doc
    // truong khong co tren document la rules ERROR, ma rules ERROR thi tu choi
    // TOAN BO yeu cau, ke ca yeu cau cua nguoi khong lien quan.
    function banDoc() {
      return get(/databases/$(database)/documents/bans/$(request.auth.uid)).data;
    }

    // Se khong duoc goi khi document chua ton tai: rules khong "truyen ngan"
    // qua ten tai mot document khong co, nen exists() phai nam o ben goi.
    function banStillRunning() {
      return !('expiresAt' in banDoc()) || banDoc().expiresAt > request.time;
    }

    // 'ALL' cat mot luc ca app lan AI; 'AI' chi cat AI.
    function isBannedFor(kind) {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid)) &&
        banStillRunning() &&
        (!('scope' in banDoc()) || banDoc().scope == 'ALL' || banDoc().scope == kind);
    }

    // Tai khoan bi cam thi khong duoc doc/ghi ho so cua chinh no. Day la noi
    // lenh "Cam" trong app quan tri TRUOC tien thanh hieu luc — khong phai chi
    // la mot dong ghi chu trong /bans.
    function notBanned() {
      return !isBannedFor('ALL');
    }

    // "Cam hoi AI" trong app quan tri: cat duong ghi bo dem len /users, de
    // so lieu hom nay khong con la cho client tu cat guc duoc. KHONG the cat
    // duoc Goi AI that su tu day — cau hoi di thang tu may len nha cung cap
    // bang khoa nam trong APK (task #45 mới chan tan goc duoc).
    function notAiBanned() {
      return !isBannedFor('AI');
    }

    // "Tai khoan dang bi xoa" = chinh chu da XA document users/<uid> cua minh
    // roi, va dang don cac document con lai. Day la cach duy nhat de rules phan
    // biet mot lenh "xoa vi tri" nam trong dong bo chay bang nut "Xóa tài
    // khoản" voi lenh xoa rieng mot dung luong de an duong di — truong hop sau
    // van bi chan ngat o /locations khi ho so con ton tai.
    //
    // Thu tu DUY NHAT app duoc phep chay: users/<uid> truoc, roi toi locations
    // va vet di chuyen. Dao nguoc thi lenh xoa bi tu choi va app phai noi ro
    // dieu do.
    function accountIsBeingDeleted(userId) {
      return isOwner(userId) &&
        !exists(/databases/$(database)/documents/users/$(userId));
    }

    // CO GAP NOI THAT HAY CHUA — doi chieu HAI UID tren document ghep noi,
    // khong bao gio tin chu document duoc hoi. Ly do phai tinh tay doi:
    // `locations`, `sos_alerts`, `calls` nam ngon, ngoai document ghep noi,
    // nen trong rules khong co san hai uid cua cap do; ma rules Firestore cung
    // khong duoc phep truy van — chi get() duoc mot ID MA MINH TU TINH DUOC.
    //
    // Ba dieu kien: document ghep noi phai TON TAI, trang thai phai la
    // 'PAIRED' (dung cai ma UI dang dung: activePairing.status ==
    // PairingStatus.PAIRED — huy ghep la cat duong doc ngay), va
    // {parentId, childId} phai khop dung {a, b}.
    function pairOfTwo(pairingId, a, b) {
      return isAuthenticated() &&
        pairingId is string && pairingId != '' &&
        exists(/databases/$(database)/documents/pairings/$(pairingId)) &&
        get(/databases/$(database)/documents/pairings/$(pairingId)).data.status == 'PAIRED' &&
        get(/databases/$(database)/documents/pairings/$(pairingId)).data.parentId in [a, b] &&
        get(/databases/$(database)/documents/pairings/$(pairingId)).data.childId in [a, b] &&
        get(/databases/$(database)/documents/pairings/$(pairingId)).data.parentId !=
          get(/databases/$(database)/documents/pairings/$(pairingId)).data.childId;
    }

    // Cong thuc id ghep noi app dang tao (VesperaRepository.kt):
    // "pair_" + uidPhuHuynh + "_" + uidHocSinh. Rules khong biet ben nao la
    // cha ben nao la con nen phai thu CA HAI thu tu.
    //
    // NHUNG pairOfTwo MOT MINH THUA: document ghep noi do client tu ghi, nen
    // bat ky tai khoan nao cung tao duoc `pair_<minh>_<nan nhan>` voi status
    // 'PAIRED' (allow create chi can minh nam trong hai ten) — the la no mo
    // duoc dinh vi cua nan nhan ma chua co ai dua tay. Ben kia phai TU XAC
    // NHAN bang cach ghi `activePairingId` len ho so cua chinh no, va
    // `users/{uid}` chi isOwner sua duoc (ban 55.0) nen loi do khong tai tao
    // duoc. Do la "chinh chung hai chu" ma rules dam tin.
    function attestedPair(pairingId, otherUid) {
      return pairOfTwo(pairingId, request.auth.uid, otherUid) &&
        exists(/databases/$(database)/documents/users/$(otherUid)) &&
        'activePairingId' in get(/databases/$(database)/documents/users/$(otherUid)).data &&
        get(/databases/$(database)/documents/users/$(otherUid)).data.activePairingId == pairingId;
    }

    function isPairedWith(otherUid) {
      return attestedPair('pair_' + request.auth.uid + '_' + otherUid, otherUid) ||
        attestedPair('pair_' + otherUid + '_' + request.auth.uid, otherUid);
    }

    // ── VI TRI: CUA AI ──────────────────────────────────────────────────────
    // Cac document o ngon luu chu nhan trong truong `userId` va id ghep noi
    // trong truong `pairingId` (id document la `uid` hoac `uid_<timestamp>`).
    // `pairingId` chi la MOT CANDI: doc ra xong van phai dua len document
    // ghep noi that doi hai uid (pairOfTwo), nen mot tai khoan gian
    // pairingId = "pair_<nha nguoi khac>" cung khong mo duoc du lieu cua ho.
    // Thieu truong (kq la null) bi tu choi vi `is string`.

    // LUOT HOI AI MOT NGAY (ban 64.0). App nguoi dung tu dem va tu ghi len
    // `users/<uid>`, nen o day co hai tran:
    //   aiQuotaFieldsValid  — con so khong duoc vuot 100, khong duoc am, va
    //                         phai di kem chuoi ngay "yyyy-MM-dd".
    //   aiQuotaNotShrunk    — trong CUNG mot ngay thi so do chi duoc tang. Day
    //                         la tran that: xoa du lieu ung dung lam bo dem tren
    //                         may ve 0, nhung viet len lai "1" se bi tu choi vi
    //                         van con la ngay cu. Sang ngay moi (aiUsageDay khac)
    //                         moi duoc bat dau lai tu 1.
    // Nhin thang: cat 100 luot van la do app lam, vi cau hoi AI di thang len
    // Gemini/OpenRouter bang khoa nam trong APK, khong qua Firebase. Muon chan
    // cung o tang may chu thi can proxy (task #45), khong phai them rules.
    function aiQuotaFieldsValid() {
      return !('aiUsageToday' in request.resource.data) ||
        (request.resource.data.aiUsageToday is int &&
         request.resource.data.aiUsageToday >= 0 &&
         request.resource.data.aiUsageToday <= 100 &&
         'aiUsageDay' in request.resource.data &&
         request.resource.data.aiUsageDay is string &&
         request.resource.data.aiUsageDay.size() == 10);
    }

    function aiQuotaNotShrunk() {
      return !('aiUsageToday' in request.resource.data) ||
        !('aiUsageDay' in resource.data) ||
        !('aiUsageToday' in resource.data) ||
        resource.data.aiUsageDay != request.resource.data.aiUsageDay ||
        resource.data.aiUsageToday <= request.resource.data.aiUsageToday;
    }

    // "Lang phi nay co cham vao bo dem AI khong?" — dung de lenh "cam hoi AI"
    // trong app quan tri chi cat duong ghi bo dem, khong cat luon duong cap
    // nhat ho so (ten, lop, anh dai dien) cua mot tai khoan dang bi cam AI.
    // So sanh bang diff() vi `set(merge)` tra ve DOCUMENT SAU KHI HOP NHAT,
    // nen nhin tran lang se thay "ca document" va doai sai.
    // `resource` chi ton tai trong update/create nen ham nay chi dung o update.
    function aiQuotaTouched() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['aiUsageToday', 'aiUsageDay']);
    }

    // User profiles
    match /users/{userId} {
      // notBanned(): tai khoan bi cam trong app quan tri mat het duong doc/ghi
      // ho so — day la phan "lenh cam tro thanh hieu luc".
      //
      // allow delete (doi tu `if false` o ban 55.0): chu TAI KHOAN duoc tu xoa
      // ho so cua minh — do la quyen rieng tu ma app phai thua theo, va nut
      // "Xóa tài khoản" trong app dan nguoi dung toi mot lenh that. Nguoi dung
      // KHONG xoa duoc khi dang bi cam (phai hoac mo cam, hoac quan tri xoa).
      // QUAN TRI xoa duoc ho so cua bat ky ai, day la duong de don tai khoan
      // thu nghiem ma khong can mo bang dieu khi Firebase.
      //
      // Trần không vượt được ở đây: rules khong cat duoc tai khoan trong
      // Authentication (email + mat khau), vi client khong co Admin SDK. Xoa
      // het document roi thi dang nhap lai van con, va mo app se tao document
      // moi — app phai noi dieu nay thang ra tren man hinh.
      allow read: if isAuthenticated() && notBanned();
      allow create: if isOwner(userId) && notBanned() && aiQuotaFieldsValid();
      allow update: if isOwner(userId) && notBanned() &&
        aiQuotaFieldsValid() && aiQuotaNotShrunk() &&
        (notAiBanned() || !aiQuotaTouched());
      allow delete: if (isOwner(userId) && notBanned()) || isAdmin();
    }

    // /bans/{uid} — lenh cam theo uid. Day la con duong DUY NHAT co that:
    // Firestore rules khong co bien IP, va dien thoai di dong doi IP lien tuc
    // qua CGNAT nen "chan IP" vua khong lam duoc vua khong co nghia.
    // Mot lenh Cam ghi len phai tro dung nguoi, dung pham vi, va neu co han
    // thi han phai o TUONG LAI. Ly do khong chan `expiresAt` qua khus: document
    // `bans/<uid>` ton tai = lenh cam con hieu luc theo ban 63.0, ma
    // `isBannedFor()` o tren doc truong nay — mot lenh cam da het han duoc ghi
    // len se KHONG bi mo tu dong ma bi "vinh vien nguoc" (con document ma
    // khong ai nhin ra vi sao no mo). App phai xoa document khi mo cam.
    function banWriteIsValid(targetUid) {
      return isAuthenticated() &&
        request.resource.data.uid == targetUid &&
        request.resource.data.scope in ['ALL', 'AI'] &&
        (!('expiresAt' in request.resource.data) ||
          (request.resource.data.expiresAt is timestamp &&
            request.resource.data.expiresAt > request.time)) &&
        (!('reason' in request.resource.data) ||
          request.resource.data.reason is string);
    }

    match /bans/{uid} {
      // Doc: chi chinh chu tai khoan (de app cua no biet minh bi cam va in
      // ly do ra man hinh) hoac quan tri (danh sach nguoi bi cam). Truoc day
      // `isAuthenticated()` nghia la bat ky ai cung liet ke duoc ai dang bi
      // cam trong he thong.
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow create, update: if isAdmin() && banWriteIsValid(uid);
      allow delete: if isAdmin();
    }

    // Pairings
    match /pairings/{pairingId} {
      // Document nay chua ten hai ben, ma ghep noi, va co quan "ghi duoc
      // duong di chuyen khong". Doc duoc boi chinh hai nguoi trong cap, cong
      // them quan tri (app `:admin` can nhin danh sach ghep noi khi xu ly don).
      allow read: if isPairMember(pairingId) || isAdmin();
      // Tao ghep noi thi phai LA nguoi dung o vai phu huynh trong document —
      // khong the "ghep noi ho gium" hai nguoi khac, cung khong the tao mot
      // document co `childId` la nan nhan de may nan nhan (dang chua ghep noi)
      // tu nhan lay. App that luong nay o `pairDirectly`: CHUA document nao
      // cung co parentId = uid dang dang nhap.
      allow create: if isAuthenticated() && notBanned() &&
        request.resource.data.parentId == request.auth.uid;
      // Update phai dua tren hai ben cua document CU (resource.data), KHONG
      // phai document moi. Vi sao ky: dieu kien "request.resource.data.childId
      // == toi" cho phep mot tai khoan la ghi `childId = toi` len document
      // ghep noi cua mot gia dinh khac — ngay khi xong, no LA thanh vien cua
      // cap do va doc duoc het noi quy, tin nhan, duong di cua ho tu
      // `pairings/<id>/*`. Voi `users/{uid}` doc duoc toan tap thi uid nan nhan
      // la thu kiem duoc de tay, nen hai dong duoi day tung la cua ngo.
      // Day la cho ghi "ai dang tat/bat ghi dinh vi" va trang thai ghep noi —
      // ca hai thu deu do me hoac con lam, nen doi chieu ben CU la du.
      allow update: if notBanned() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.childId == request.auth.uid
      );
      allow delete: if isPairMember(pairingId) || isAdmin();

      // Bay (7) block ben duoi (schedules / rule_audit / agreements / extra_time /
      // privacy_requests / messages / location_history) deu co `|| isAdmin()`,
      // boi nut "Xóa tài khoản" phia quan tri (ban 66.0) khong chi xoa document
      // ghep noi — Firestore KHONG tu xoa subcollection cua no, va muon don
      // tung thu thi quan tri phai doc duoc danh sach. Quyen do rong, nen hay
      // xem no nhu quyen cua chu project: ADMIN_UIDS va ham isAdmin() o phia
      // tren la noi duy nhat cap quyen nay, khong phai client.

      // NOI QUY GIA DINH. Hai ben deu ghi duoc vi co che me-con-dong-long
      // cho phep ca hai ben goi de xuat; quyen "tu duyet phieu cua minh" la
      // quy tac UI, kiem tra o ConsentPolicy.kt (chua phai o day).
      match /schedules/{scheduleId} {
        allow read, write: if isPairMember(pairingId) || isAdmin();
      }

      // Nhat ky noi quy: KHONG sua duoc — sua la gia mau, ma nhat ky la thu
      // de ngai "me doi luat vao luc nao". Xoa thi chi duoc trong HAI truong
      // hop: quan tri don tai khoan, hoac chinh chu dang bi don (nut "Xóa tài
      // khoản": ho so users/<uid> da mat ma document ghep noi con nguyen).
      // Muon xoa duoc nhat ky thi app phai don subcollection TRUOC khi xoa
      // document ghep noi — isPairMember() get() tren document do, document
      // mat roi thi lenh xoa bi tu choi (dung y: khong de lai vet ma khong ai
      // don duoc nua).
      match /rule_audit/{entryId} {
        allow read, create: if isPairMember(pairingId);
        allow update: if false;
        allow delete: if isAdmin() ||
          (isPairMember(pairingId) && accountIsBeingDeleted(request.auth.uid));
      }

      match /agreements/{agreementId} {
        allow read, write: if isPairMember(pairingId) || isAdmin();
      }

      match /extra_time/{requestId} {
        allow read, write: if isPairMember(pairingId) || isAdmin();
      }

      match /privacy_requests/{requestId} {
        allow read, write: if isPairMember(pairingId) || isAdmin();
      }

      match /messages/{messageId} {
        allow read, write: if isPairMember(pairingId) || isAdmin();
      }

      match /location_history/{historyId} {
        allow read, write: if isPairMember(pairingId) || isAdmin();
      }
    }

    // Pairing requests — VÔ SINH từ bản 59.0 (bỏ mã PIN, phụ huynh gõ mã
    // trực tiếp). Khong con dong code nao doc/ghi collection nay, nen no bi
    // den hoan toan. Neu mot ban APK cu (<=58.0) van ghi vao day thi phep ghep
    // noi cua ban DO that bai — do la gia phai tra cho viec "ai cung vao duoc
    // hop thu ghep noi cua nguoi khac".
    match /pairing_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    // Realtime locations
    //
    // `locations/<uid>` la document DUY NHAT chua toa do, pin, app dang dung
    // cua mot may. Mo nhu cu (= bat ky tai khoan nao doc/ghi duoc) nghia la
    // moi nguoi co mot tai khoan Firebase mien phi deu biet nha khac o dau,
    // luc nao. Nay khe lai thanh: chu may, va nguoi DA GHEP NOI that — tim
    // theo ca hai duong: cong thuc id hien tai, hoac `pairingId` ghi trong
    // chinh document (cap ghep noi tao tu ban cu co the mang id khac cong
    // thuc nay). Ca hai duong deu phai qua attestedPair: document ghep noi
    // phai co that, PAIRED, khop hai uid, VA ben kia da tu ghi
    // `activePairingId` len ho so cua chinh no.
    match /locations/{userId} {
      // 66.0: `isAdmin()` dat len TRUOC tien. Ly do khong phai muon "doc len
      // cua nguoi khac" cho vui — nut "Xóa tài khoản" phia quan tri phai LIET
      // KE duoc document cua nguoi bi don thi moi xoa duoc tung cai: Firestore
      // khong co lenh xoa theo truong, va app quan tri khong co Admin SDK. Dat
      // dau tien con de lenh doc khong bi loi `get()` khi ho so da bi xoa.
      allow read: if isAdmin() ||
        (isAuthenticated() && notBanned() &&
          (request.auth.uid == userId ||
           isPairedWith(userId) ||
           attestedPair(resource.data.pairingId, userId)));

      // Chu document duoc ghi toan bo (app gui telemetry cua chinh no).
      // Ngoai le DUY NHAT: phieu "gio trong quyen rieng" duoc phu huynh
      // duyet, nen may PHU HUYNH phai ghi duoc len document cua con — va chi
      // duoc doi hai truong that cua phep do. `set(..., merge)` khien
      // request.resource.data la CA document sau khi hop nhat, nen phai so
      // sanh voi resource.data bang diff() chu khong duoc kiem keys tran lang.
      allow create: if notBanned() && (
        request.auth.uid == userId ||
        (isPairedWith(userId) &&
         request.resource.data.keys().hasOnly(['isPrivacyActive', 'updatedAt']))
      );
      allow update: if notBanned() && (
        request.auth.uid == userId ||
        ((isPairedWith(userId) ||
          attestedPair(resource.data.pairingId, userId)) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isPrivacyActive', 'updatedAt']))
      );
      // Xoa vi tri: KHONG mo cho chu may khi ho so con ton tai — do telemetry
      // tu ghi de, va "xoa don duong di" la thu ma hoc sinh khong nen lam duoc
      // (no giau duoc het vet, con hon tat GPS). Buong khi ho so da bi xoa that
      // su (accountIsBeingDeleted) hoac khi quan tri ra tay.
      allow delete: if accountIsBeingDeleted(userId) || isAdmin();
    }

    // Location history (Lịch sử vị trí đẩy lên Cloud)
    //
    // O ngon nay CHINH may ghi vet di chuyen cua no va CHINH no doc lai (app
    // goi `observeLocationHistoryForUser(uid cua minh)` khi chua ghep noi;
    // `whereEqualTo("userId", uid)` trong query khop het voi dieu kien duoi
    // day nen Firestore khong tu choi query). Cap da ghep noi xem duong di
    // qua `pairings/{id}/location_history` — da khoa theo isPairMember.
    //
    // `isAdmin()` trong dieu kien doc la phan bat buoc cua nut "Xóa tài khoản"
    // phia quan tri: id cua vet di chuyen la ngau nhien, khong doc duoc danh
    // sach thi khong the xoa tung cai.
    match /location_history/{historyId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && notBanned() &&
          resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && notBanned() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && notBanned() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      // Vet di chuyen cua ai thi theo do: chu may don duoc khi ho so cua no
      // da bi xoa (nut "Xóa tài khoản"), quan tri don bat ky luc nao. Query
      // `whereEqualTo("userId", uid)` cua app khop dieu kien nay nen khong bi
      // Firestore tu choi lien dai.
      allow delete: if accountIsBeingDeleted(resource.data.userId) || isAdmin();
    }

    // SOS Alerts
    //
    // Phieu SOS do may co lap (`document("<uid>_<timestamp>")`), nen ghi chi
    // duoc phep khi truong userId trong phieu dung la uid cua chinh may.
    // Doc: chu may + nguoi ghep noi voi no (phu huynh phai nhin duoc duong
    // day, do la toan bo y nghia cua nut SOS).
    match /sos_alerts/{alertId} {
      // `isAdmin()` dau tien: quan tri don tai khoan phai liet ke duoc phieu
      // SOS cua nguoi do (id dang form `<uid>_<timestamp>` nhung khong the suy
      // ra timestamp), va de lenh doc khong bi loi `get()` khi da xong ho so.
      allow read: if isAdmin() ||
        (isAuthenticated() && notBanned() &&
          (resource.data.userId == request.auth.uid ||
           isPairedWith(resource.data.userId) ||
           attestedPair(resource.data.pairingId, resource.data.userId)));
      allow create: if isAuthenticated() && notBanned() &&
        request.resource.data.userId == request.auth.uid;
      // Phieu SOS da lap thi khong ai duoc sua (do la chung cu, khong phai
      // ban nhap); xoa chi khi tai khoan dang bi don that su hoac quan tri
      // don cho chu tai khoan.
      allow update: if false;
      allow delete: if accountIsBeingDeleted(resource.data.userId) || isAdmin();
    }

    // Calls (WebRTC signaling)
    //
    // SDP + danh sach ICE cua cuoc goi gia dinh. May goi dat
    // `roomId = activePairing.id`, tuc id document CHINH LA id ghep noi, nen
    // chi can kiem tra minh la mot ben cua cap do. Nhin `room_<uid>` la canh
    // bao noi trong DashboardScreen khi CHUA ghep noi (khong co dau ben kia
    // de ket noi) — giu cho may do doc/ghi duoc document cua chinh no.
    //
    // `isAdmin()` o day la cho ban 66.0: don tai khoan (nguoi dung tu xoa hoac
    // quan tri xoa) thi `calls/<pairingId>` cung phai xoa duoc, neu khong thi
    // bien dong "da xoa N muc" cua app luon luon sai vi mot nhom ma khong ai
    // lay lai duoc.
    match /calls/{callId} {
      allow read, write: if isAdmin() || (isAuthenticated() && notBanned() && (
        (exists(/databases/$(database)/documents/pairings/$(callId)) &&
         isPairMember(callId)) ||
        callId == 'room_' + request.auth.uid
      ));

      match /{document=**} {
        allow read, write: if isAdmin() || (isAuthenticated() && notBanned() && (
          (exists(/databases/$(database)/documents/pairings/$(callId)) &&
           isPairMember(callId)) ||
          callId == 'room_' + request.auth.uid
        ));
      }
    }
  }
}
